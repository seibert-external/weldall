{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weldall.dev/schemas/manifest/v1.json",
  "title": "Weldall native YAML manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "workspace"],
  "properties": {
    "apiVersion": {
      "const": "weldall.dev/v1"
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "issuer"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "issuer": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      }
    },
    "cli": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logoUrl"],
      "properties": {
        "logoUrl": {
          "type": "string",
          "maxLength": 2000,
          "pattern": "^(|https://)"
        }
      }
    },
    "include": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "scopes": {
      "type": "object",
      "maxProperties": 1000,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]{0,119}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "description"],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[a-z][a-z0-9._-]*:[a-z][a-z0-9._-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "maxProperties": 1000,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]{0,119}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "name",
          "resourceIdentifier",
          "authorizationServer",
          "downstreamClientId",
          "enabled",
          "requestPrefixes",
          "scopes"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[a-z0-9._-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "resourceIdentifier": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "authorizationServer": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://[^/?#]+/?$"
          },
          "downstreamClientId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "enabled": {
            "type": "boolean"
          },
          "skillDiscoveryEnabled": {
            "type": "boolean",
            "default": false
          },
          "requestPrefixes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            }
          },
          "scopes": {
            "type": "array",
            "minItems": 0,
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          }
        }
      }
    },
    "skills": {
      "type": "object",
      "maxProperties": 1000,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]{0,119}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "title", "content", "requiredScopes", "visibility"],
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000
          },
          "requiredScopes": {
            "type": "array",
            "minItems": 0,
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[a-z][a-z0-9._-]*:[a-z][a-z0-9._-]*$"
            }
          },
          "visibility": {
            "enum": ["DEFAULT", "HIDDEN_IF_UNALLOWED"]
          }
        }
      }
    },
    "machines": {
      "type": "object",
      "maxProperties": 1000,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]{0,119}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["clientId", "name", "enabled", "resources", "scopes"],
        "properties": {
          "clientId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "enabled": {
            "type": "boolean"
          },
          "publicKeys": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9_-]{0,119}$"
            },
            "additionalProperties": {
              "$ref": "#/$defs/publicJwk"
            }
          },
          "resources": {
            "type": "array",
            "minItems": 0,
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "scopes": {
            "type": "array",
            "minItems": 0,
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          }
        }
      }
    },
    "emailAssignments": {
      "type": "object",
      "maxProperties": 1000,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]{0,119}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["email", "scopes"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 320
          },
          "scopes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          }
        }
      }
    },
    "groupAssignments": {
      "type": "object",
      "maxProperties": 1000,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]{0,119}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "groupId", "scopes"],
        "properties": {
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "groupId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 191
          },
          "scopes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          }
        }
      }
    }
  },
  "$defs": {
    "objectMap": {
      "type": "object",
      "maxProperties": 1000,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]{0,119}$"
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "publicJwk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kty", "crv", "x", "y"],
      "properties": {
        "kty": {
          "const": "EC"
        },
        "crv": {
          "const": "P-256"
        },
        "x": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "y": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "alg": {
          "const": "ES256"
        },
        "use": {
          "const": "sig"
        }
      }
    }
  }
}
