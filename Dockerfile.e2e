FROM node:24-bookworm-slim AS app

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates openssl \
  && rm -rf /var/lib/apt/lists/* \
  && corepack enable
WORKDIR /workspace

COPY . .
RUN pnpm install --frozen-lockfile
RUN POSTGRES_URL=postgresql://postgres:postgres@postgres:5432/postgres pnpm db:generate \
  && pnpm --filter @weldall/sdk build \
  && pnpm --filter @weldall/db build \
  && pnpm --filter @weldall/cli build \
  && pnpm --filter @weldall/browser build \
  && pnpm --filter @weldall/expenses build \
  && pnpm --filter @weldall/dev-idp build
RUN mkdir -p /tmp/browser-pack /workspace/.e2e-browser-package \
  && pnpm --filter @weldall/browser pack --pack-destination /tmp/browser-pack \
  && tar -xzf /tmp/browser-pack/weldall-browser-*.tgz -C /workspace/.e2e-browser-package --strip-components=1 \
  && test -f /workspace/.e2e-browser-package/dist/index.js

FROM app AS e2e
RUN pnpm --filter @weldall/e2e exec playwright install --with-deps chromium \
  && apt-get update \
  && apt-get install -y --no-install-recommends libnss3-tools \
  && rm -rf /var/lib/apt/lists/*
