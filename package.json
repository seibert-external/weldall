{
  "name": "weldall-prototype",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "admin:bootstrap": "pnpm --filter @weldall/weldall admin:bootstrap",
    "build": "turbo run build",
    "build:dev": "turbo run build --filter=!@weldall/weldall",
    "cli:link": "pnpm --filter @weldall/ci build && ln -sf \"$PWD/apps/cli/dist/index.js\" \"$(dirname \"$(command -v node)\")/weldall\"",
    "dev": "turbo run dev --filter=@weldall/weldall --filter=@weldall/expenses --filter=@weldall/dev-idp",
    "format": "prettier --no-error-on-unmatched-pattern --write \"apps/**/*.{ts,tsx,js,mjs,json,css}\" \"examples/**/*.{ts,tsx,js,mjs,json,md}\" \"packages/**/*.{ts,json}\" \"scripts/**/*.{ts,js,mjs}\" \"tooling/**/*.{ts,js,json}\" \".forgejo/**/*.{yaml,yml}\" \".changeset/**/*.md\" \".releases/**/*.{md,json}\" \"*.{json,yaml,yml}\" \"!pnpm-lock.yaml\" \"*.md\"",
    "format:check": "prettier --no-error-on-unmatched-pattern --check \"apps/**/*.{ts,tsx,js,mjs,json,css}\" \"examples/**/*.{ts,tsx,js,mjs,json,md}\" \"packages/**/*.{ts,json}\" \"scripts/**/*.{ts,js,mjs}\" \"tooling/**/*.{ts,js,json}\" \".forgejo/**/*.{yaml,yml}\" \".changeset/**/*.md\" \".releases/**/*.{md,json}\" \"*.{json,yaml,yml}\" \"!pnpm-lock.yaml\" \"*.md\"",
    "lint": "eslint apps packages scripts && turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "bash scripts/test-e2e.sh",
    "db:generate": "pnpm --filter @weldall/db generate",
    "db:migrate:deploy": "pnpm --filter @weldall/db migrate:deploy",
    "secrets:generate": "tsx scripts/generate-env.ts",
    "changes:status": "pnpm change status",
    "release:check-intents": "node scripts/release/check-change-intents.mjs",
    "release:forgejo": "node scripts/release/create-forgejo-releases.mjs",
    "release:manifest": "node scripts/release/release-manifest.mjs",
    "release:prepare": "node scripts/release/prepare-release-plan.mjs",
    "release:publish": "node scripts/release/publish-packages.mjs",
    "release:test": "node --test scripts/release/*.test.mjs",
    "release:version": "pnpm version -r"
  },
  "devDependencies": {
    "@weldall/eslint-config": "workspace:*",
    "@weldall/prettier-config": "workspace:*",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9.39.5",
    "jose": "^6.2.4",
    "prettier": "catalog:",
    "tsx": "^4.21.0",
    "turbo": "^2.8.12",
    "typescript": "catalog:"
  },
  "prettier": "@weldall/prettier-config"
}
