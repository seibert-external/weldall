{
  "name": "weldall-prototype",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "admin:bootstrap": "pnpm --filter @weldall/weldall admin:bootstrap",
    "build": "turbo run build",
    "build:dev": "turbo run build --filter=!@weldall/weldall",
    "check": "eslint apps packages scripts && turbo run lint typecheck",
    "cli:link": "pnpm --filter @weldall/cli build && ln -sf \"$PWD/apps/cli/dist/index.js\" \"$(dirname \"$(command -v node)\")/weldall\"",
    "dev": "turbo run dev --filter=@weldall/weldall --filter=@weldall/expenses --filter=@weldall/dev-idp --filter=@weldall/docs",
    "docs:dev": "pnpm --filter @weldall/docs dev",
    "format": "prettier --no-error-on-unmatched-pattern --write \"apps/**/*.{ts,tsx,js,mjs,json,css,astro,md,mdx}\" \"examples/**/*.{ts,tsx,js,mjs,json,md}\" \"packages/**/*.{ts,json}\" \"scripts/**/*.{ts,js,mjs}\" \"tooling/**/*.{ts,js,json}\" \".github/**/*.{yaml,yml}\" \".changeset/**/*.{md,json}\" \"*.{json,yaml,yml}\" \"!pnpm-lock.yaml\" \"*.md\"",
    "format:check": "prettier --no-error-on-unmatched-pattern --check \"apps/**/*.{ts,tsx,js,mjs,json,css,astro,md,mdx}\" \"examples/**/*.{ts,tsx,js,mjs,json,md}\" \"packages/**/*.{ts,json}\" \"scripts/**/*.{ts,js,mjs}\" \"tooling/**/*.{ts,js,json}\" \".github/**/*.{yaml,yml}\" \".changeset/**/*.{md,json}\" \"*.{json,yaml,yml}\" \"!pnpm-lock.yaml\" \"*.md\"",
    "lint": "eslint apps packages scripts && turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "bash scripts/test-e2e.sh",
    "db:generate": "pnpm --filter @weldall/db generate",
    "db:migrate:deploy": "pnpm --filter @weldall/db migrate:deploy",
    "db:seed:production": "pnpm --filter @weldall/db seed:production",
    "db:seed:development": "pnpm --filter @weldall/db seed:development",
    "secrets:generate": "tsx scripts/generate-env.ts",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@weldall/eslint-config": "workspace:*",
    "@weldall/prettier-config": "workspace:*",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9.39.5",
    "jose": "^6.2.4",
    "prettier": "catalog:",
    "tsx": "^4.21.0",
    "turbo": "^2.8.12",
    "typescript": "catalog:"
  },
  "prettier": "@weldall/prettier-config"
}
