{
  "name": "@weldall/cli",
  "version": "0.7.0",
  "description": "Weldall CLI for Linux/macOS IaC and macOS user sessions",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seibert-external/weldall.git",
    "directory": "apps/cli"
  },
  "type": "module",
  "os": [
    "darwin",
    "linux"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "files": [
    "dist/index.js",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "weldall": "dist/index.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "pack:check": "pnpm build && node scripts/verify-package.mjs",
    "prepack": "pnpm build",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "gunshi": "^0.37.1",
    "ink": "^7.1.1",
    "jose": "^6.2.2",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.4",
    "yaml": "^2.9.0"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "1.3.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.17",
    "@weldall/sdk": "workspace:*",
    "@weldall/tsconfig": "workspace:*",
    "esbuild": "^0.28.1",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
