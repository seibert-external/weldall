{
  "name": "@weldall/browser",
  "version": "0.1.0",
  "description": "Browser-only Weldall client for sender-constrained SPA connections",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seibert-external/weldall.git",
    "directory": "packages/browser"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "fixture:packed": "pnpm build && node scripts/prepare-packed-browser-fixture.mjs",
    "test:browser": "playwright test",
    "test:browser:list": "playwright test --list",
    "pack:check": "pnpm build && node scripts/verify-package.mjs && node scripts/prepare-packed-browser-fixture.mjs",
    "prepack": "pnpm build",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@weldall/tsconfig": "workspace:*",
    "esbuild": "^0.28.1",
    "fake-indexeddb": "^6.2.4",
    "jose": "^6.2.4",
    "typescript": "catalog:",
    "vite": "^7.1.7",
    "vitest": "catalog:"
  }
}
