{
  "name": "@weldall/db",
  "version": "0.0.0",
  "license": "FSL-1.1-ALv2",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "generate": "prisma generate --schema prisma/schema.prisma",
    "migrate:deploy": "pnpm with-env prisma migrate deploy --schema prisma/schema.prisma",
    "reset:hard": "pnpm with-env tsx scripts/hard-reset.ts",
    "seed:production": "pnpm with-env tsx prisma/seed.ts",
    "seed:development": "pnpm seed:production && pnpm with-env tsx prisma/seed.dev.ts",
    "with-env": "dotenv -e ../../.env --",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@weldall/tsconfig": "workspace:*",
    "prisma": "6.19.3",
    "tsx": "^4.23.12",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
