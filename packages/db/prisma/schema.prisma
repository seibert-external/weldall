generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model User {
  id                          String                     @id
  name                        String
  email                       String                     @unique
  emailVerified               Boolean
  image                       String?
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt
  sessions                    Session[]
  accounts                    Account[]
  browserConnectionApprovals  BrowserConnectionRequest[] @relation("BrowserConnectionApprovalUser")
  browserConnectionDecisions  BrowserConnectionRequest[] @relation("BrowserConnectionDecisionUser")
  browserConnectionReferences BrowserConnection[]        @relation("BrowserConnectionUser")
}

model Scope {
  id                 String                @id @default(cuid())
  key                String                @unique
  description        String
  isSystem           Boolean               @default(false)
  version            Int                   @default(1)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  createdBy          String
  updatedBy          String
  grants             EmailScopeGrant[]
  groupGrants        GroupScopeGrant[]
  resources          ResourceScope[]
  allowedForMachines MachineAllowedScope[]
  iacBinding         IacObjectBinding?

  @@index([updatedAt])
}

model EmailScopeAssignment {
  id              String            @id @default(cuid())
  normalizedEmail String            @unique
  version         Int               @default(1)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  createdBy       String
  updatedBy       String
  grants          EmailScopeGrant[]
  iacBinding      IacObjectBinding?

  @@index([updatedAt])
}

model EmailScopeGrant {
  id           String               @id @default(cuid())
  assignmentId String
  scopeId      String
  createdAt    DateTime             @default(now())
  createdBy    String
  assignment   EmailScopeAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  scope        Scope                @relation(fields: [scopeId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, scopeId])
  @@index([scopeId])
}

model GroupProvider {
  id                   String                 @id @default(cuid())
  key                  String                 @unique
  name                 String
  adapterType          String
  baseUrl              String
  encryptedToken       String
  encryptionKeyVersion Int
  enabled              Boolean                @default(true)
  version              Int                    @default(1)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  createdBy            String
  updatedBy            String
  assignments          GroupScopeAssignment[]

  @@index([enabled])
  @@index([updatedAt])
}

model GroupScopeAssignment {
  id         String            @id @default(cuid())
  providerId String
  groupId    String
  version    Int               @default(1)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  createdBy  String
  updatedBy  String
  provider   GroupProvider     @relation(fields: [providerId], references: [id], onDelete: Restrict)
  grants     GroupScopeGrant[]
  iacBinding IacObjectBinding?

  @@unique([providerId, groupId])
  @@index([updatedAt])
}

model GroupScopeGrant {
  id           String               @id @default(cuid())
  assignmentId String
  scopeId      String
  createdAt    DateTime             @default(now())
  createdBy    String
  assignment   GroupScopeAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  scope        Scope                @relation(fields: [scopeId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, scopeId])
  @@index([scopeId])
}

enum SkillVisibility {
  DEFAULT
  HIDDEN_IF_UNALLOWED
}

model Skill {
  id             String            @id @default(cuid())
  slug           String            @unique
  title          String
  content        String
  requiredScopes String[]          @default([])
  visibility     SkillVisibility   @default(DEFAULT)
  version        Int               @default(1)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  createdBy      String
  updatedBy      String
  iacBinding     IacObjectBinding?

  @@index([updatedAt])
}

model CliSettings {
  id        String   @id @default("default")
  appendix  String   @default("")
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  updatedBy String
}

model DownstreamResource {
  id                        String                     @id @default(cuid())
  key                       String                     @unique
  name                      String
  resourceIdentifier        String                     @unique
  authorizationServer       String
  downstreamClientId        String
  enabled                   Boolean                    @default(true)
  skillDiscoveryEnabled     Boolean                    @default(false)
  version                   Int                        @default(1)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  createdBy                 String
  updatedBy                 String
  scopes                    ResourceScope[]
  requestPrefixes           ResourceRequestPrefix[]
  discoveredCatalog         DiscoveredSkillCatalog?
  allowedForMachines        MachineAllowedResource[]
  iacBinding                IacObjectBinding?
  browserConnectionRequests BrowserConnectionRequest[]
  browserConnections        BrowserConnection[]

  @@index([name])
  @@index([updatedAt])
  @@index([enabled])
}

model DiscoveredSkillCatalog {
  id                      String             @id @default(cuid())
  resourceId              String             @unique
  sourceResourceVersion   Int?
  schemaVersion           Int?
  metadataUrl             String?
  catalogEndpoint         String?
  lastAttemptAt           DateTime?
  lastSuccessfulRefreshAt DateTime?
  nextRefreshAt           DateTime           @default(now())
  staleAfter              DateTime?
  refreshLeaseId          String?
  refreshLeaseUntil       DateTime?
  retryCount              Int                @default(0)
  lastFailureCategory     String?
  lastFailureAt           DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  resource                DownstreamResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  skills                  DiscoveredSkill[]

  @@index([nextRefreshAt, refreshLeaseUntil])
}

model DiscoveredSkill {
  id             String                 @id @default(cuid())
  catalogId      String
  localId        String
  canonicalId    String                 @unique
  title          String
  content        String
  requiredScopes String[]               @default([])
  visibility     SkillVisibility        @default(DEFAULT)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  catalog        DiscoveredSkillCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)

  @@unique([catalogId, localId])
  @@index([catalogId])
}

model ResourceScope {
  resourceId String
  scopeId    String
  resource   DownstreamResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  scope      Scope              @relation(fields: [scopeId], references: [id], onDelete: Restrict)

  @@id([resourceId, scopeId])
  @@index([scopeId])
}

model ResourceRequestPrefix {
  id         String             @id @default(cuid())
  resourceId String
  urlPrefix  String             @unique
  createdAt  DateTime           @default(now())
  createdBy  String
  resource   DownstreamResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId])
}

model MachineClient {
  id               String                   @id @default(cuid())
  clientId         String                   @unique
  name             String
  enabled          Boolean                  @default(true)
  deactivatedAt    DateTime?
  version          Int                      @default(1)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  createdBy        String
  updatedBy        String
  keys             MachineClientKey[]
  allowedResources MachineAllowedResource[]
  allowedScopes    MachineAllowedScope[]
  iacBinding       IacObjectBinding?

  @@index([enabled])
  @@index([updatedAt])
}

model MachineClientKey {
  id              String        @id @default(cuid())
  machineClientId String
  kid             String
  publicJwk       Json
  thumbprint      String        @unique
  revokedAt       DateTime?
  createdAt       DateTime      @default(now())
  createdBy       String
  revokedBy       String?
  client          MachineClient @relation(fields: [machineClientId], references: [id], onDelete: Cascade)

  @@unique([machineClientId, kid])
  @@index([machineClientId, revokedAt], map: "MachineClientKey_active_idx")
}

model MachineAllowedResource {
  machineClientId String
  resourceId      String
  client          MachineClient      @relation(fields: [machineClientId], references: [id], onDelete: Cascade)
  resource        DownstreamResource @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  @@id([machineClientId, resourceId])
  @@index([resourceId])
}

model MachineAllowedScope {
  machineClientId String
  scopeId         String
  client          MachineClient @relation(fields: [machineClientId], references: [id], onDelete: Cascade)
  scope           Scope         @relation(fields: [scopeId], references: [id], onDelete: Restrict)

  @@id([machineClientId, scopeId])
  @@index([scopeId])
}

enum IacPrimitiveKind {
  SCOPE
  RESOURCE
  MACHINE
  EMAIL_ASSIGNMENT
  GROUP_ASSIGNMENT
  SKILL
}

enum IacOperationType {
  APPLY
  IMPORT
  UNMANAGE
  STATE_MOVE
}

enum IacOperationStatus {
  STARTED
  SUCCEEDED
  FAILED
}

/// Persistent database-installation identity advertised in discovery and pinned in IaC lockfiles.
model InstallationIdentity {
  /// Fixed singleton row key; this is not the installation UUID.
  id             String   @id @default("default")
  installationId String   @unique @db.Uuid
  createdAt      DateTime @default(now())
}

model IacWorkspace {
  id               String             @id @db.Uuid
  name             String
  issuer           String
  revision         Int                @default(0)
  lastConfigDigest String?
  lastActorId      String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  bindings         IacObjectBinding[]
  operations       IacOperation[]

  @@index([updatedAt])
}

model IacObjectBinding {
  id                String                @id @default(cuid())
  workspaceId       String                @db.Uuid
  address           String
  kind              IacPrimitiveKind
  naturalIdentity   String
  scopeId           String?               @unique
  resourceId        String?               @unique
  machineClientId   String?               @unique
  emailAssignmentId String?               @unique
  groupAssignmentId String?               @unique
  skillId           String?               @unique
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  workspace         IacWorkspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  scope             Scope?                @relation(fields: [scopeId], references: [id], onDelete: SetNull)
  resource          DownstreamResource?   @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  machineClient     MachineClient?        @relation(fields: [machineClientId], references: [id], onDelete: SetNull)
  emailAssignment   EmailScopeAssignment? @relation(fields: [emailAssignmentId], references: [id], onDelete: SetNull)
  groupAssignment   GroupScopeAssignment? @relation(fields: [groupAssignmentId], references: [id], onDelete: SetNull)
  skill             Skill?                @relation(fields: [skillId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, address])
  @@index([workspaceId, kind])
}

model ReplayMarker {
  key       String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model IacOperation {
  id                String             @id @db.Uuid
  workspaceId       String             @db.Uuid
  type              IacOperationType
  requestDigest     String
  priorRevision     Int
  resultingRevision Int?
  status            IacOperationStatus @default(STARTED)
  resultSummary     Json               @default("{}")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  workspace         IacWorkspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

model AuditEvent {
  id               String   @id @default(cuid())
  schemaVersion    Int      @default(1)
  eventType        String
  occurredAt       DateTime @default(now())
  actorType        String
  actorId          String
  actorEmail       String?
  clientId         String?
  requestId        String
  correlationId    String?
  deduplicationKey String?  @unique
  outcome          String
  reasonCode       String?
  subjectType      String?
  subjectId        String?
  metadata         Json
  createdAt        DateTime @default(now())

  @@index([occurredAt, id])
  @@index([eventType, occurredAt, id])
  @@index([actorId, occurredAt, id])
  @@index([actorEmail, occurredAt, id])
  @@index([subjectType, subjectId, occurredAt, id])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                    String    @id
  issuer                String
  providerAccountId     String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, providerAccountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Jwks {
  id         String    @id
  publicKey  String
  privateKey String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
}

model OauthClient {
  id                               String                     @id
  clientId                         String                     @unique
  clientSecret                     String?
  disabled                         Boolean                    @default(false)
  skipConsent                      Boolean?
  enableEndSession                 Boolean?
  subjectType                      String?
  scopes                           String[]                   @default([])
  userId                           String?
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         String[]                   @default([])
  tos                              String?
  policy                           String?
  softwareId                       String?
  softwareVersion                  String?
  softwareStatement                String?
  redirectUris                     String[]
  postLogoutRedirectUris           String[]                   @default([])
  backchannelLogoutUri             String?
  backchannelLogoutSessionRequired Boolean?
  tokenEndpointAuthMethod          String?
  jwks                             String?
  jwksUri                          String?
  grantTypes                       String[]                   @default([])
  responseTypes                    String[]                   @default([])
  public                           Boolean?
  type                             String?
  requirePKCE                      Boolean?
  dpopBoundAccessTokens            Boolean                    @default(false)
  referenceId                      String?
  metadata                         Json?
  createdAt                        DateTime                   @default(now())
  updatedAt                        DateTime                   @updatedAt
  browserConnectionRequests        BrowserConnectionRequest[]
  browserConnections               BrowserConnection[]

  @@index([userId])
}

model OauthResource {
  id                            String   @id
  identifier                    String   @unique
  name                          String
  accessTokenTtl                Int?
  refreshTokenTtl               Int?
  signingAlgorithm              String?
  signingKeyId                  String?
  allowedScopes                 String[] @default([])
  customClaims                  Json?
  dpopBoundAccessTokensRequired Boolean  @default(false)
  disabled                      Boolean  @default(false)
  policyVersion                 Int      @default(1)
  metadata                      Json?
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt
}

model OauthClientResource {
  id         String   @id
  clientId   String
  resourceId String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([clientId])
  @@index([resourceId])
}

model OauthRefreshToken {
  id                      String    @id
  token                   String    @unique
  clientId                String
  sessionId               String?
  userId                  String
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]  @default([])
  requestedUserInfoClaims String[]  @default([])
  expiresAt               DateTime
  createdAt               DateTime  @default(now())
  revoked                 DateTime?
  rotatedAt               DateTime?
  rotationReplayResponse  String?
  rotationReplayExpiresAt DateTime?
  authTime                DateTime?
  confirmation            Json?
  scopes                  String[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
}

model OauthAccessToken {
  id                      String    @id
  token                   String    @unique
  clientId                String
  sessionId               String?
  userId                  String?
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]  @default([])
  requestedUserInfoClaims String[]  @default([])
  refreshId               String?
  expiresAt               DateTime
  createdAt               DateTime  @default(now())
  revoked                 DateTime?
  confirmation            Json?
  scopes                  String[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@index([refreshId])
}

model OauthConsent {
  id                      String   @id
  clientId                String
  userId                  String?
  referenceId             String?
  resources               String[] @default([])
  requestedUserInfoClaims String[] @default([])
  scopes                  String[]
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([clientId])
  @@index([userId])
}

model OauthClientAssertion {
  id        String   @id
  expiresAt DateTime
}

enum BrowserConnectionRequestStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
  ISSUING
  CONSUMED
}

enum BrowserConnectionIssuanceStatus {
  CLAIMED
  PROVIDER_ISSUED
  BINDING_CREATED
  COMMITTED
  FAILED
}

enum BrowserConnectionState {
  ACTIVE
  REVOKED
}

/// RFC 8628 state. Device and user codes are stored only as keyed hashes.
model BrowserConnectionRequest {
  id                  String                            @id @default(cuid())
  deviceCodeHash      String                            @unique
  userCodeHash        String                            @unique
  browserClientId     String
  oauthClientId       String
  resourceId          String
  origin              String
  dpopJkt             String
  status              BrowserConnectionRequestStatus    @default(PENDING)
  attempts            Int                               @default(0)
  pollIntervalSeconds Int                               @default(5)
  lastPolledAt        DateTime?
  issuanceClaimedAt   DateTime?
  connectionId        String?                           @unique
  expiresAt           DateTime
  approvedAt          DateTime?
  approvedByUserId    String?
  decidedByUserId     String?
  deniedAt            DateTime?
  consumedAt          DateTime?
  createdAt           DateTime                          @default(now())
  updatedAt           DateTime                          @updatedAt
  oauthClient         OauthClient                       @relation(fields: [oauthClientId], references: [id], onDelete: Cascade)
  resource            DownstreamResource                @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  approvedByUser      User?                             @relation("BrowserConnectionApprovalUser", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  decidedByUser       User?                             @relation("BrowserConnectionDecisionUser", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  issuanceAttempt     BrowserConnectionIssuanceAttempt?
  connection          BrowserConnection?                @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([status, expiresAt])
  @@index([resourceId, status, expiresAt])
  @@index([browserClientId, status, expiresAt])
  @@index([origin, status, expiresAt])
}

/// Durable, idempotent provider-issuance journal. It never stores raw credentials.
model BrowserConnectionIssuanceAttempt {
  id                       String                          @id @default(cuid())
  requestId                String                          @unique
  status                   BrowserConnectionIssuanceStatus @default(CLAIMED)
  providerAccessTokenHash  String?                         @unique
  providerRefreshTokenHash String?                         @unique
  refreshFamilyId          String                          @unique
  connectionId             String?                         @unique
  failureCode              String?
  claimedAt                DateTime                        @default(now())
  providerIssuedAt         DateTime?
  bindingCreatedAt         DateTime?
  committedAt              DateTime?
  failedAt                 DateTime?
  updatedAt                DateTime                        @updatedAt
  request                  BrowserConnectionRequest        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  connection               BrowserConnection?              @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([status, updatedAt])
}

/// Durable browser identity/key relationship. Resource and user snapshots survive deletion.
model BrowserConnection {
  id                  String                            @id @default(cuid())
  providerReferenceId String                            @unique
  browserClientId     String
  oauthClientId       String?
  resourceId          String?
  resourceKey         String
  resourceIdentifier  String
  origin              String
  userId              String
  userReferenceId     String?
  dpopJkt             String
  refreshFamilyId     String                            @unique
  approvedVia         String
  state               BrowserConnectionState            @default(ACTIVE)
  createdAt           DateTime                          @default(now())
  lastUsedAt          DateTime?
  revokedAt           DateTime?
  revokedBy           String?
  revocationReason    String?
  oauthClient         OauthClient?                      @relation(fields: [oauthClientId], references: [id], onDelete: SetNull)
  resource            DownstreamResource?               @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  userReference       User?                             @relation("BrowserConnectionUser", fields: [userReferenceId], references: [id], onDelete: SetNull)
  request             BrowserConnectionRequest?
  issuanceAttempt     BrowserConnectionIssuanceAttempt?
  refreshBindings     OAuthDeviceRefreshBinding[]       @relation("BrowserRefreshConnection")

  @@unique([id, refreshFamilyId, browserClientId, userId, dpopJkt], map: "BrowserConnection_binding_identity_key")
  @@index([userId, state])
  @@index([resourceId, state])
  @@index([resourceKey, state])
  @@index([origin, state])
  @@index([browserClientId, state])
}

/// Durable fixed-window counters used for horizontally consistent device-flow limits.
model BrowserConnectionRateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([expiresAt])
}

model OAuthDeviceRefreshBinding {
  id                  String             @id @default(cuid())
  tokenHash           String             @unique
  familyId            String
  clientId            String
  userId              String
  dpopJkt             String
  browserConnectionId String?
  expiresAt           DateTime
  rotatedAt           DateTime?
  revokedAt           DateTime?
  replacementHash     String?            @unique
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  browserConnection   BrowserConnection? @relation("BrowserRefreshConnection", fields: [browserConnectionId, familyId, clientId, userId, dpopJkt], references: [id, refreshFamilyId, browserClientId, userId, dpopJkt], onDelete: Cascade)

  @@index([familyId])
  @@index([userId, clientId])
  @@index([browserConnectionId])
}
