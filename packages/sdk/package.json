{
  "name": "@weldall/sdk",
  "version": "0.6.0",
  "description": "Weldall resource-server SDK for Fetch, Hono, Next.js, and Astro",
  "license": "FSL-1.1-ALv2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seibert-external/weldall.git",
    "directory": "packages/sdk"
  },
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "default": "./dist/hono.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./astro": {
      "types": "./dist/astro.d.ts",
      "default": "./dist/astro.js"
    },
    "./starlight": {
      "types": "./dist/starlight/index.d.ts",
      "default": "./dist/starlight/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "pack:check": "pnpm build && node scripts/verify-package.mjs && node scripts/verify-tarball-examples.mjs",
    "prepack": "pnpm build",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "jose": "^6.2.10"
  },
  "peerDependencies": {
    "astro": ">=7 <8",
    "hono": ">=4 <5",
    "next": ">=16 <17",
    "@orama/orama": "^3.1.6",
    "@orama/stemmers": "^3.0.3",
    "@orama/stopwords": "^3.0.0",
    "gray-matter": "^4.0.3"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "@orama/orama": {
      "optional": true
    },
    "@orama/stemmers": {
      "optional": true
    },
    "@orama/stopwords": {
      "optional": true
    },
    "gray-matter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@orama/orama": "^3.1.6",
    "@orama/stemmers": "^3.0.3",
    "@orama/stopwords": "^3.0.0",
    "@types/node": "catalog:",
    "@weldall/tsconfig": "workspace:*",
    "astro": "^7.2.7",
    "gray-matter": "^4.0.3",
    "hono": "^4.13.5",
    "next": "^16.3.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
