{
  "name": "@weldall/pi",
  "version": "0.2.1",
  "description": "WeldAll skills for Pi",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@weldall/cli": "workspace:^"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "pack:check": "pnpm test && pnpm build && node scripts/verify-package.mjs"
  },
  "devDependencies": {
    "@weldall/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
