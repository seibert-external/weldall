NODE_USE_SYSTEM_CA=1
POSTGRES_URL=postgresql://postgres@localhost:5433/postgres
WELDALL_ISSUER=https://weldall.seibert.localdev
BETTER_AUTH_SECRET=
# Server-only one-time setup token: base64url, generated from at least 32 random bytes.
WELDALL_SETUP_TOKEN=
# Canonical base64 32-byte AES key for OIDC, group-provider and chat credentials; keep stable.
WELDALL_CREDENTIAL_ENCRYPTION_KEY=
WELDALL_CREDENTIAL_ENCRYPTION_KEY_VERSION=1
WELDALL_DEPLOYMENT_MODE=development
LOG_LEVEL=INFO
# Dev fixtures only; production login providers are configured in /setup and /admin/login-providers.
DEV_IDP_ISSUER=https://dev-idp.seibert.localdev
DEV_IDP_CLIENT_ID=weldall-dev
DEV_IDP_CLIENT_SECRET=
DEV_IDP_SIGNING_PRIVATE_JWK='{}'
DEV_IDP_SIGNING_PUBLIC_JWK='{}'
DEV_IDP_SIGNING_KID=
# Seeds the identities the dev IdP suggests and prefills the first one; any other valid email works too.
DEV_IDP_USERS_JSON='[{"sub":"dev-alice","email":"alice@example.com","name":"Alice Dev","emailVerified":true}]'
WELDALL_SIGNING_PRIVATE_JWK='{}'
WELDALL_SIGNING_PUBLIC_JWK='{}'
WELDALL_SIGNING_KID=
EXPENSES_SIGNING_PRIVATE_JWK='{}'
EXPENSES_SIGNING_PUBLIC_JWK='{}'
EXPENSES_SIGNING_KID=
